{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-crm",
    "description": "CRM integrations package for Meros, currently Salesforce-focused.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {},
    "require-dev": {
        "illuminate/testing": "^13.0",
        "mirror-and-mountain/meros-framework": "^1.0",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "MM\\Meros\\Crm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "test:integration": "phpunit -c phpunit.integration.xml"
    },
    "autoload": {
        "psr-4": {
            "MM\\Meros\\Crm\\": "src/",
            "MM\\Meros\\Crm\\App\\": "src/app/",
            "MM\\Meros\\Crm\\Facades\\": "src/facades/",
            "MM\\Meros\\Crm\\Concerns\\": "src/concerns/"
        }
    },
    "extra": {
        "meros": {
            "provider": "MM\\Meros\\Crm\\ServiceProvider"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
