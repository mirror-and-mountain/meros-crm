{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-crm",
    "description": "CRM integrations package for Meros, currently Salesforce-focused.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {},
    "autoload": {
        "psr-4": {
            "MM\\Meros\\Crm\\": "src/",
            "MM\\Meros\\Crm\\App\\": "src/app/",
            "MM\\Meros\\Crm\\Facades\\": "src/facades/",
            "MM\\Meros\\Crm\\Concerns\\": "src/concerns/"
        }
    },
    "extra": {
        "meros": {
            "provider": "MM\\Meros\\Crm\\ServiceProvider"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
